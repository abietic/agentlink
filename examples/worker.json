{
  "server_url": "https://agentlink.example.com",
  "name": "my-laptop",
  "bot": "",
  "allowed_users": [],
  "workdir_roots": ["~/Code"],
  "default_workdir": "~/Code",
  "runner": ["/opt/homebrew/bin/node", "/Users/me/.agentlink/sdk/runner.mjs"],
  "sdk_options": {
    "permissionMode": "auto",
    "systemPrompt": {
      "type": "preset",
      "preset": "claude_code",
      "append": "You are answering a message from a Tanka group chat. Keep the reply short and use markdown."
    }
  },
  "timeout_sec": 1800,
  "max_concurrency": 2,
  "max_output_chars": 3500,
  "triggers": []
}
