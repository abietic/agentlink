{
  "server_url": "https://agentlink.example.com",
  "name": "my-laptop",
  "allowed_users": [],
  "workdir_roots": ["~/Code"],
  "default_workdir": "~/Code",
  "claude_bin": "claude",
  "claude_args": [
    "--permission-prompts", "none",
    "--append-system-prompt", "You are answering a message from a Tanka group chat. Keep the reply short and use markdown."
  ],
  "timeout_sec": 1800,
  "max_concurrency": 2,
  "max_output_chars": 3500
}
